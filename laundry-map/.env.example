# Node 24+. Set securely in runtime; never commit credentials.
ADMIN_USER=hq
# Required, at least 16 characters. No default password.
ADMIN_PASSWORD=
PORT=3000
DATA_DIR=./data
# Production requires HTTPS; secure cookies are enabled in production.
NODE_ENV=development
# Set true only on the server. One structured Nominatim lookup per unresolved store per boot.
GEOCODE_ON_START=false
# none | gdrive | file | s3. Production choice is gdrive. Do not commit tokens.
PERSIST_DRIVER=none
# Personal Drive: OAuth refresh token, scope https://www.googleapis.com/auth/drive.file only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_REDIRECT_URI=http://127.0.0.1
# Optional service account for a Shared Drive. Personal Gmail has no service-account quota.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_DRIVE_FOLDER_ID=
# PERSIST_FILE_DIR=/absolute/path/outside/DATA_DIR
# Optional S3-compatible driver. Not the selected production store.
# PERSIST_S3_ENDPOINT=
# PERSIST_S3_BUCKET=
# PERSIST_S3_REGION=auto
# PERSIST_S3_ACCESS_KEY_ID=
# PERSIST_S3_SECRET_ACCESS_KEY=
